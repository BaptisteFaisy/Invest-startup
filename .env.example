# Serveur local
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Base de données
MONGODB_URI=mongodb://localhost:27017

# Secrets applicatifs — utiliser des valeurs aléatoires d'au moins 32 caractères
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-different-random-secret-of-at-least-32-characters

# Vérification des adresses email via Resend
# Facultatif en développement ; obligatoire avec NODE_ENV=production.
RESEND_API_KEY=
EMAIL_FROM="Liquid Plus <comptes@liquidplus.fr>"

# Encaissement de l'accès Liquid+ par virement SEPA — obligatoire en production.
# Le serveur ne constate pas la réception des fonds : il émet une référence
# (LQP-<id>-<hex>), l'affiche au fondateur, et l'accès est activé à la main
# depuis l'admin une fois le virement vu sur le compte. Sans IBAN ni titulaire,
# le paiement par virement se désactive proprement (503) au lieu d'afficher des
# coordonnées vides. Ne jamais versionner ces valeurs : Railway → Variables.
LIQUIDPLUS_IBAN=
LIQUIDPLUS_BIC=
LIQUIDPLUS_ACCOUNT_HOLDER=

# Paiements Stripe — HORS SERVICE depuis le 2026-07-21 (compte refusé par Stripe).
# Conservé le temps de la migration ; le paiement passe par virement ci-dessus.
# Accès Liquid+ (600 € TTC ; 450 € TTC avec le code RAISE SUMMIT) : paiement
# unique encaissé par Liquid+. Webhook du compte plateforme :
#   https://votre-domaine/api/billing/stripe-webhook
# Honoraires avocat : paiement direct sur le compte Stripe du cabinet (Connect).
# Webhook DISTINCT des comptes connectés :
#   https://votre-domaine/api/payments/stripe-connect-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Intégrations facultatives
ZAI_API_KEY=
CLOUDCONVERT_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
