{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git fetch *)",
      "Bash(git patch-id *)",
      "Bash(git add *)",
      "Bash(git reset *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\gaiam\\.agentsroom\\hooks\\notify-agentsroom.py\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\gaiam\\.agentsroom\\hooks\\notify-agentsroom.py\"",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\gaiam\\.agentsroom\\hooks\\notify-agentsroom.py\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\gaiam\\.agentsroom\\hooks\\notify-agentsroom.py\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\gaiam\\.agentsroom\\hooks\\notify-agentsroom.py\"",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\gaiam\\.agentsroom\\hooks\\notify-agentsroom.py\"",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:\\Users\\gaiam\\.agentsroom\\hooks\\notify-agentsroom.py\"",
            "async": true
          }
        ]
      }
    ]
  }
}
