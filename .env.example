# Serveur local
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Base de données
MONGODB_URI=mongodb://localhost:27017

# Secrets applicatifs — utiliser des valeurs aléatoires d'au moins 32 caractères
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-different-random-secret-of-at-least-32-characters

# Vérification des adresses email via Resend
# Facultatif en développement ; obligatoire avec NODE_ENV=production.
RESEND_API_KEY=
EMAIL_FROM="Liquid Plus <comptes@liquidplus.fr>"

# Intégrations facultatives
ZAI_API_KEY=
CLOUDCONVERT_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
